{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "farzadblack-com",
    "compatibility_date": "2026-10-22",
    "workers_dev": true,
    "preview_urls": true,
    "assets": {
        "directory": "./dist",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page"
    }
}