---
import { siteData } from "../data/site-data";

const navItems = [
  { name: "خانه", href: "/" },
  { name: "پروژه‌ها", href: "/projects/" },
  { name: "پکیج‌ها", href: "/packages/" },
  { name: "مهارت‌ها", href: "/skills/" },
  { name: "ارتباط", href: "/#contact" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-transparent bg-(--bg-primary)/95 py-4 transition-all duration-300"
>
  <nav
    class="container mx-auto flex items-center justify-between gap-4 px-6"
    aria-label="ناوبری اصلی"
  >
    <a
      href="/"
      class="group flex shrink-0 items-center gap-3 text-xl font-black tracking-tight text-(--text-primary) md:text-2xl"
      aria-label="صفحه اصلی فرزاد شریفی"
    >
      <img
        src={siteData.avatar}
        alt=""
        width="40"
        height="40"
        class="size-10 rounded-full object-cover transition-transform group-hover:scale-105"
      />
      <span>{siteData.brand}</span>
    </a>

    <div class="flex shrink-0 items-center gap-8">
      <div class="hidden items-center gap-8 md:flex">
        {
          navItems.map((item) => {
            const active =
              item.href === "/"
                ? currentPath === "/"
                : currentPath === item.href.replace(/\/+$/, "") ||
                  currentPath.startsWith(item.href);

            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "text-sm font-bold transition-colors hover:text-orange-500",
                  active ? "text-orange-500" : "text-(--text-secondary)",
                ]}
              >
                {item.name}
              </a>
            );
          })
        }
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          class="flex size-10 items-center justify-center rounded-xl border border-(--border-primary) bg-(--bg-secondary) text-(--text-secondary) transition-colors hover:text-orange-500"
          aria-label="تغییر پوسته"
          title="تغییر پوسته"
        >
          <svg
            id="theme-icon-moon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6.5 6.5 0 0 0 8.268 8.268c.344-.215.825-.003.803.401"
            ></path>
          </svg>

          <svg
            id="theme-icon-sun"
            class="hidden"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
            ></path>
          </svg>
        </button>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="flex size-10 items-center justify-center rounded-xl border border-(--border-primary) bg-(--bg-secondary) text-(--text-secondary) transition-colors hover:text-orange-500 md:hidden"
          aria-label="باز کردن منو"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="mobile-menu-icon-open"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>

          <svg
            id="mobile-menu-icon-close"
            class="hidden"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m18 6-12 12M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="container mx-auto hidden px-6 pb-3 pt-5 md:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="ناوبری موبایل">
      {
        navItems.map((item) => {
          const active =
            item.href === "/"
              ? currentPath === "/"
              : currentPath === item.href.replace(/\/+$/, "") ||
                currentPath.startsWith(item.href);

          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-xl px-4 py-3 text-sm font-bold transition-colors hover:bg-(--bg-secondary) hover:text-orange-500",
                active
                  ? "bg-(--bg-secondary) text-orange-500"
                  : "text-(--text-secondary)",
              ]}
            >
              {item.name}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeToggle =
    document.querySelector<HTMLButtonElement>("#theme-toggle");
  const moonIcon = document.querySelector<SVGElement>("#theme-icon-moon");
  const sunIcon = document.querySelector<SVGElement>("#theme-icon-sun");

  const mobileMenuToggle = document.querySelector<HTMLButtonElement>(
    "#mobile-menu-toggle",
  );
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
  const menuOpenIcon = document.querySelector<SVGElement>(
    "#mobile-menu-icon-open",
  );
  const menuCloseIcon = document.querySelector<SVGElement>(
    "#mobile-menu-icon-close",
  );
  const header = document.querySelector<HTMLElement>("#site-header");

  const applyThemeIcon = () => {
    const isDark = root.classList.contains("dark");

    moonIcon?.classList.toggle("hidden", isDark);
    sunIcon?.classList.toggle("hidden", !isDark);
  };

  const setTheme = (isDark: boolean) => {
    root.classList.toggle("dark", isDark);

    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {}

    applyThemeIcon();
  };

  applyThemeIcon();

  themeToggle?.addEventListener("click", () => {
    setTheme(!root.classList.contains("dark"));
  });

  const setMobileMenu = (isOpen: boolean) => {
    if (!mobileMenu || !mobileMenuToggle) return;

    mobileMenu.hidden = !isOpen;
    mobileMenu.classList.toggle("hidden", !isOpen);

    mobileMenuToggle.setAttribute("aria-expanded", String(isOpen));
    mobileMenuToggle.setAttribute(
      "aria-label",
      isOpen ? "بستن منو" : "باز کردن منو",
    );

    menuOpenIcon?.classList.toggle("hidden", isOpen);
    menuCloseIcon?.classList.toggle("hidden", !isOpen);
  };

  mobileMenuToggle?.addEventListener("click", () => {
    const isOpen = mobileMenuToggle.getAttribute("aria-expanded") === "true";

    setMobileMenu(!isOpen);
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMobileMenu(false));
  });

  const updateHeader = () => {
    const scrolled = window.scrollY > 20;

    header?.classList.toggle("py-3", scrolled);
    header?.classList.toggle("py-4", !scrolled);
    header?.classList.toggle("border-(--border-primary)", scrolled);
    header?.classList.toggle("backdrop-blur-xl", scrolled);
    header?.classList.toggle("shadow-sm", scrolled);
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
</script>
