---
import type { Project } from "../../data/projects";
import ImageFrame from "../Global/ImageFrame.astro";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<article
    class="group flex flex-col overflow-hidden rounded-2xl border border-(--text-secondary)/10 bg-(--bg-secondary) transition duration-300 hover:-translate-y-1"
>
    <ImageFrame
        src={project.image}
        alt={`تصویر پروژه ${project.name}`}
        class="aspect-video shrink-0"
        imageClass="transition duration-500 group-hover:scale-105"
    >
        {
            project.technologies.length > 0 && (
                <div class="flex flex-wrap gap-2">
                    {project.technologies.slice(0, 3).map((technology) => (
                        <span class="rounded-md border border-white/10 bg-(--bg-secondary)/80 px-2.5 py-1 text-xs font-semibold text-(--text-primary) shadow-sm backdrop-blur-sm">
                            {technology}
                        </span>
                    ))}
                </div>
            )
        }
    </ImageFrame>

    <div class="flex flex-1 flex-col p-5">
        <h3 class="line-clamp-1 text-lg font-black text-(--text-primary)">
            {project.name}
        </h3>

        <p class="mt-3 min-h-20 text-sm leading-6 text-(--text-secondary)">
            {project.summary}
        </p>

        <div
            class="mt-2 flex flex-wrap items-center gap-4 border-t border-(--text-secondary)/10 pt-4"
        >
            <a
                href={`/projects/${project.slug}/`}
                class="inline-flex items-center gap-2 text-sm font-bold text-orange-500 transition hover:gap-3 hover:text-orange-400"
                aria-label={`جزئیات پروژه ${project.name}`}
            >
                جزئیات پروژه
                <span aria-hidden="true">←</span>
            </a>
        </div>
    </div>
</article>
