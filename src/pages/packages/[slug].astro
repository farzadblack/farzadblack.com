---
import Layout from "../../layouts/Layout.astro";
import { packages } from "../../data/packages";

export function getStaticPaths() {
    return packages.map((pkg) => ({
        params: { slug: pkg.slug },
        props: { pkg },
    }));
}

const { pkg } = Astro.props;

const composerName = new URL(pkg.packageUrl).pathname.replace(
    /^\/packages\//,
    "",
);

const installCommand = `composer require ${composerName}`;
---

<Layout title={pkg.name} description={pkg.summary}>
    <article class="bg-(--bg-primary) py-8 sm:py-10 md:py-16">
        <div class="container mx-auto px-5 md:px-6">
            <div
                class="overflow-hidden rounded-2xl border border-(--border-primary) bg-(--bg-secondary)"
            >
                <div class="relative">
                    <img
                        src={pkg.image}
                        alt={pkg.name}
                        class="aspect-[4/3] w-full object-cover sm:aspect-video"
                        fetchpriority="high"
                    />

                    <div
                        class="absolute inset-0 bg-[linear-gradient(to_top,var(--bg-secondary)_0%,color-mix(in_srgb,var(--bg-secondary)_75%,transparent)_15%,color-mix(in_srgb,var(--bg-secondary)_35%,transparent)_30%,transparent_50%)]"
                        aria-hidden="true"
                    >
                    </div>

                    <div class="absolute inset-x-0 bottom-0 p-5 sm:p-8 md:p-10">
                        <h1
                            class="text-2xl font-black leading-tight text-(--text-primary) sm:text-3xl md:text-5xl"
                        >
                            {pkg.name}
                        </h1>

                        <div
                            class="mt-4 h-1 w-14 rounded-full bg-orange-500 sm:w-20"
                            aria-hidden="true"
                        >
                        </div>
                    </div>
                </div>

                <div class="p-5 sm:p-8 md:p-10">
                    <p
                        class="text-sm leading-8 text-(--text-secondary) sm:text-base sm:leading-9 md:text-lg"
                    >
                        {pkg.summary}
                    </p>
                </div>
            </div>

            <div
                class="mt-10 grid items-start gap-8 md:mt-14 md:grid-cols-[minmax(0,1fr)_280px] md:gap-10 lg:gap-14"
            >
                <section class="min-w-0">
                    <h2
                        class="text-xl font-black text-(--text-primary) sm:text-2xl"
                    >
                        درباره پکیج
                    </h2>

                    <div
                        class="mt-5 whitespace-pre-line text-sm leading-8 text-(--text-secondary) sm:text-base sm:leading-9"
                    >
                        {pkg.description}
                    </div>

                    <section
                        class="mt-10 border-t border-(--border-primary) pt-8"
                    >
                        <h2
                            class="text-xl font-black text-(--text-primary) sm:text-2xl"
                        >
                            نصب پکیج
                        </h2>

                        <p
                            class="mt-3 text-sm leading-8 text-(--text-secondary) sm:text-base"
                        >
                            برای نصب این پکیج، دستور زیر را در ترمینال پروژه
                            اجرا کنید.
                        </p>

                        <div
                            class="mt-5 flex flex-col gap-3 rounded-xl border border-(--border-primary) bg-(--bg-secondary) p-4 sm:flex-row sm:items-center sm:justify-between"
                        >
                            <code
                                dir="ltr"
                                class="min-w-0 break-all text-left text-sm text-(--text-primary)"
                            >
                                {installCommand}
                            </code>

                            <button
                                type="button"
                                class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-orange-500 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-orange-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
                                onclick={`navigator.clipboard.writeText(${JSON.stringify(installCommand)}).then(() => { this.textContent = "کپی شد ✓"; }).catch(() => { this.textContent = "کپی ناموفق بود"; });`}
                            >
                                کپی دستور
                            </button>
                        </div>
                    </section>
                </section>

                <aside
                    class="h-fit rounded-2xl border border-(--border-primary) bg-(--bg-secondary) p-5 sm:p-6"
                >
                    <h2 class="text-lg font-black text-(--text-primary)">
                        دسترسی به پکیج
                    </h2>

                    <p class="mt-2 text-sm leading-7 text-(--text-secondary)">
                        مشاهده کد منبع، مستندات و نسخه منتشرشده پکیج.
                    </p>

                    <div class="mt-5 space-y-3">
                        <a
                            href={pkg.repository}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex w-full items-center justify-center gap-2 rounded-xl border border-(--border-primary) px-4 py-3.5 text-sm font-bold text-(--text-primary) transition hover:border-orange-500 hover:text-orange-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
                        >
                            مخزن GitHub
                            <span aria-hidden="true">↗</span>
                        </a>

                        <a
                            href={pkg.packageUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex w-full items-center justify-center gap-2 rounded-xl bg-orange-500 px-4 py-3.5 text-sm font-bold text-white transition hover:bg-orange-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
                        >
                            مشاهده در Packagist
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                </aside>
            </div>

            <div class="mt-12 pt-7 sm:mt-16 sm:pt-8">
                <a
                    href="/packages/"
                    class="inline-flex items-center gap-2 text-sm font-bold text-orange-500 transition hover:text-orange-400"
                >
                    <span aria-hidden="true">→</span>
                    مشاهده سایر پکیج‌ها
                </a>
            </div>
        </div>
    </article>
</Layout>
